{
  "name": "careui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "types": "dist/types/ds-index.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:registry": "tsx scripts/generate-registry.ts",
    "registry:generate": "tsx scripts/generate-registry.ts",
    "registry:watch": "tsx --watch scripts/generate-registry.ts",
    "registry:add-jsdoc": "tsx scripts/add-jsdoc.ts",
    "registry:check": "tsx scripts/check-registry.ts && pnpm run registry:check:deps",
    "registry:check:deps": "tsx scripts/validate-registry-dependencies.ts",
    "registry:validate": "pnpm dlx shadcn@latest registry validate --cwd public registry.json",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "preview": "vite preview",
    "prepublishOnly": "npm run build:registry && npm run registry:check:deps"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@chenglou/pretext": "^0.0.5",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/figtree": "^5.2.10",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-table": "^8.21.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "glob": "^11.1.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.7.0",
    "motion": "^12.38.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.7",
    "react-resizable-panels": "^4.7.6",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/glob": "^9.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright": "^1.61.0",
    "prettier": "^3.8.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "shadcn": "^3.8.5",
    "tsx": "^4.22.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.0.16"
  }
}
