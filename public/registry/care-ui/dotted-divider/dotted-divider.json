{
  "name": "dotted-divider",
  "type": "registry:ui",
  "registryDependencies": [],
  "files": [
    {
      "path": "registry/care-ui/dotted-divider/dotted-divider.tsx",
      "content": "/**\n * @name dotted-divider\n * @description A decorative divider rendered as a staggered dot-matrix SVG pattern.\n * @dependencies\n * @type registry:ui\n */\nimport * as React from \"react\"\n\nimport { cn } from \"@/lib/utils\"\n\nfunction DottedDivider({ className, ...props }: React.ComponentProps<\"div\">) {\n  const id = React.useId()\n  const patternId = `dotted-divider-${id.replace(/:/g, \"\")}`\n\n  return (\n    <div\n      data-slot=\"dotted-divider\"\n      className={cn(\"h-2 w-full text-border-strong\", className)}\n      {...props}\n    >\n      <svg\n        width=\"100%\"\n        height=\"100%\"\n        xmlns=\"http://www.w3.org/2000/svg\"\n        aria-hidden=\"true\"\n        style={{ display: \"block\" }}\n      >\n        <defs>\n          <pattern\n            id={patternId}\n            width=\"8\"\n            height=\"8\"\n            patternUnits=\"userSpaceOnUse\"\n          >\n            <circle cx=\"0.5\" cy=\"0.5\" r=\"0.5\" fill=\"currentColor\" />\n            <circle cx=\"0.5\" cy=\"7.5\" r=\"0.5\" fill=\"currentColor\" />\n            <circle cx=\"4\" cy=\"4\" r=\"0.5\" fill=\"currentColor\" />\n          </pattern>\n        </defs>\n        <rect width=\"100%\" height=\"100%\" fill={`url(#${patternId})`} />\n      </svg>\n    </div>\n  )\n}\n\nexport { DottedDivider }\n",
      "type": "registry:component",
      "target": "components/careui/dotted-divider.tsx"
    }
  ]
}